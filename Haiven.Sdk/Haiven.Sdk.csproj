<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Unity's supported surface. The whole point of pinning it here is that a
         binding which compiles under net10.0 tells you nothing about whether it
         compiles for a game. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Not in netstandard2.1's box. Recording the reference is part of the
         finding: a Unity consumer inherits this dependency or supplies its own
         reader. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
